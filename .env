; Name of the device that shows up in Plex
NAME="Tablo 4th Gen Proxy"
; Fake HDHomeRun device ID shown to Plex. Must be 8 hexadecimal characters
; (0-9, A-F) and unique per tuner Plex sees. If left blank or invalid, a
; stable one is generated automatically from this machine.
DEVICE_ID="12345679"
; The port for the plex server to reach
; default "8181"
PORT="8181"
; How often the app rechecks the server for the channel lineup in days
; Note: Can be triggered manually once the app is running
; Is triggered more often when creating your own XML guide data
; default "30" (once a month)
LINEUP_UPDATE_INTERVAL="30"
; If you want to create an xml guide for the channels from Tablo's data instead of Plex
; While more accurate, requires more requests and processing time to build
; Will create a new lineup file once a day
; default "false"
CREATE_XML="false"
; The amount of days the guide will populate
; The more days, the longer it will take to populate on update
; default "2", max "7"
GUIDE_DAYS="2"
; Due to issues with Plex not loading more than one EPG
; You can include the guide data with your guide as long as it's at /.pseudotv/xmltv.xml
; default "false"
INCLUDE_PSEUDOTV_GUIDE="false"
; Logger level.
; debug = Logs everything
; warn  = Also logs stuff to look out for
; error = Logs just info and errors
; info  = Just the basics are logged
; default "error"
LOG_LEVEL="error"
; If you want to create a log file of all console output.
; Contents of the file is based on the LOG_LEVEL and found in the /logs folder
; default "false"
SAVE_LOG="false"
; Overide the output directory. Default is excution directory.
OUT_DIR=""
; Device to use if you have more than one on your account.
TABLO_DEVICE=""
; Username to use for when creds.bin isn't present.
; Also enables automatic re-login: if the Tablo session token expires while
; running (streams start failing with "Authentication failure"), the app will
; silently log back in and refresh the token instead of needing a manual
; re-cred. Requires USER_PASS to be set as well.
USER_NAME=""
; Password to use for when creds.bin isn't present. Also used for the
; automatic re-login described above.
USER_PASS=""
; Set the IP Address of Tablo2Plex statically.
IP_ADDRESS=""
; How often to update your XML guide data in hours
; default "24" (once a day)
GUIDE_UPDATE_INTERVAL="24"
; Include OTT (Over-The-Top) channels in the line up (default "true")
INCLUDE_OTT="true"
; Seconds to keep a tuner "warm" after you stop watching a channel, so
; switching back to it is instant instead of waiting ~5-6s for the Tablo to
; spin the tuner up again. NOTE: a warm tuner still occupies one of your
; physical tuners for this long; it is auto-reclaimed if all tuners are needed
; for new streams. 0 disables it (default). Try "60" for snappy channel surfing.
WARM_TUNER_SECONDS="0"
